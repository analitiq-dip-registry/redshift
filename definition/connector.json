{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "redshift",
  "display_name": "Amazon Redshift",
  "description": "Amazon Redshift cloud data warehouse connector using the vendor-supported synchronous SQLAlchemy driver redshift+redshift_connector (Amazon's redshift-connector DBAPI via the sqlalchemy-redshift dialect). Redshift has no first-class ADBC driver and exposes no Arrow Flight SQL endpoint; its native bulk load (COPY) reads only from S3/EMR/DynamoDB/SSH and never from the client connection, so there is no COPY FROM STDIN path to implement and the connector uses the SQLAlchemy transport for connect, DDL, and writes: batched INSERT plus a MERGE-based upsert (Redshift has no ON CONFLICT), with no bulk-load mechanism declared. The engine dispatches the synchronous driver on its sync engine path. Works with both provisioned clusters (host *.redshift.amazonaws.com) and Redshift Serverless (host *.redshift-serverless.amazonaws.com), both on port 5439. Authenticates with a Redshift database username and password. TLS is negotiated through the redshift_connector driver's two connect parameters (ssl + sslmode); the driver documents only the certificate-verification modes verify-ca and verify-full and verifies against its bundled Amazon Trust CA. AWS IAM database authentication and IdP/SSO federation are alternatives to a static username/password but are NOT modeled in this connector version.",
  "documentation_url": "https://docs.aws.amazon.com/redshift/latest/dg/welcome.html",
  "tags": [
    "database",
    "warehouse",
    "redshift",
    "amazon",
    "aws",
    "sqlalchemy"
  ],
  "version": "1.0.0",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "sqlalchemy",
      "driver": "redshift+redshift_connector",
      "dsn": {
        "kind": "url_template",
        "template": "redshift+redshift_connector://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": {
              "ref": "connection.parameters.host"
            },
            "encoding": "host"
          },
          "port": {
            "value": {
              "ref": "connection.parameters.port"
            },
            "encoding": "raw"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          }
        }
      },
      "tls": {
        "mode": {
          "ref": "connection.parameters.ssl_mode"
        },
        "ca_certificate": {
          "ref": "secrets.ssl_ca_certificate"
        }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Host",
          "placeholder": "cluster-name.xxxxxxxxxxxx.us-west-1.redshift.amazonaws.com"
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": true,
        "default": 5439,
        "ui": {
          "label": "Port"
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Database",
          "placeholder": "dev"
        }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username"
        }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      },
      "ssl_mode": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "enum": [
          "verify-ca",
          "verify-full"
        ],
        "default": "verify-ca",
        "ui": {
          "label": "SSL mode"
        }
      },
      "ssl_ca_certificate": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": false,
        "secret": true,
        "ui": {
          "label": "SSL CA certificate (PEM)",
          "widget": "textarea"
        }
      }
    }
  },
  "resource_discovery": {
    "strategy": "information_schema",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "options": {
      "exclude_schemas": [
        "information_schema",
        "pg_catalog",
        "pg_internal"
      ]
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  },
  "sql_capabilities": {
    "catalog": "read",
    "session_targeting": "per_statement",
    "merge_form": "merge",
    "bulk_load": {},
    "stage": {
      "scope": "temp",
      "schema": "target",
      "transactional_ddl": true
    },
    "limits": {
      "max_bind_params": 32767,
      "max_identifier_len": 127
    }
  },
  "write_unit": {
    "rows": 2000,
    "bytes": 1048576
  },
  "concurrency": {
    "max_connections": 50
  },
  "error_map": {
    "key_attrs": [
      "sqlstate"
    ],
    "codes": {
      "28000": "auth",
      "40001": "transient",
      "42501": "config",
      "42P01": "config",
      "42804": "write_rejected",
      "53300": "transient",
      "57014": "transient"
    }
  }
}
