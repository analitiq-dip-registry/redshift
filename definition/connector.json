{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "redshift",
  "display_name": "Amazon Redshift",
  "description": "Amazon Redshift cloud data warehouse connector using the vendor-supported synchronous SQLAlchemy driver redshift+redshift_connector (Amazon's redshift-connector DBAPI via the sqlalchemy-redshift dialect). Redshift has no first-class ADBC driver and exposes no Arrow Flight SQL endpoint; its native bulk-load path is COPY FROM S3 (not the PostgreSQL COPY FROM STDIN protocol) and requires external S3 staging plus IAM, so this connector uses the SQLAlchemy transport for connect, DDL, and writes (batched INSERT with a MERGE-based upsert). The engine dispatches the synchronous driver on its sync engine path. Authenticates with a Redshift database username and password. Works with both provisioned clusters (host *.redshift.amazonaws.com) and Redshift Serverless (host *.redshift-serverless.amazonaws.com), both on port 5439. TLS is negotiated through the redshift_connector driver's two connect parameters (ssl + sslmode); the driver documents only the certificate-verification modes verify-ca and verify-full and verifies against its bundled Amazon Trust CA. AWS IAM database authentication and IdP/SSO federation are alternatives to a static username/password but are NOT modeled in this connector version.",
  "tags": [
    "database",
    "warehouse",
    "redshift",
    "amazon",
    "aws",
    "sqlalchemy"
  ],
  "version": "0.0.1",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "sqlalchemy",
      "driver": "redshift+redshift_connector",
      "dsn": {
        "kind": "url_template",
        "template": "redshift+redshift_connector://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": {
              "ref": "connection.parameters.host"
            },
            "encoding": "host"
          },
          "port": {
            "value": {
              "ref": "connection.parameters.port"
            },
            "encoding": "raw"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          }
        }
      },
      "tls": {
        "mode": {
          "ref": "connection.parameters.ssl_mode"
        },
        "ca_certificate": {
          "ref": "secrets.ssl_ca_certificate"
        }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Host",
          "placeholder": "cluster-name.xxxxxxxxxxxx.us-west-1.redshift.amazonaws.com"
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": true,
        "default": 5439,
        "ui": {
          "label": "Port"
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Database",
          "placeholder": "dev"
        }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username"
        }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      },
      "ssl_mode": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "enum": [
          "verify-ca",
          "verify-full"
        ],
        "default": "verify-ca",
        "ui": {
          "label": "SSL mode"
        }
      },
      "ssl_ca_certificate": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": false,
        "secret": true,
        "ui": {
          "label": "SSL CA certificate (PEM)",
          "widget": "textarea"
        }
      }
    }
  },
  "resource_discovery": {
    "strategy": "information_schema",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "options": {
      "exclude_schemas": [
        "information_schema",
        "pg_catalog",
        "pg_internal"
      ]
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
