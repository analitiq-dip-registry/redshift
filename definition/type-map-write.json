{
  "$schema": "https://schemas.analitiq.ai/type-map-write/latest.json",
  "direction": "write",
  "rules": [
    {
      "match": "exact",
      "native_type": "VARCHAR(65535)",
      "arrow_type": "Null"
    },
    {
      "match": "exact",
      "native_type": "BOOLEAN",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "Int8"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "Int16"
    },
    {
      "match": "exact",
      "native_type": "INTEGER",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "SMALLINT",
      "arrow_type": "UInt8"
    },
    {
      "match": "exact",
      "native_type": "INTEGER",
      "arrow_type": "UInt16"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "UInt32"
    },
    {
      "match": "exact",
      "native_type": "BIGINT",
      "arrow_type": "UInt64"
    },
    {
      "match": "exact",
      "native_type": "REAL",
      "arrow_type": "Float16"
    },
    {
      "match": "exact",
      "native_type": "REAL",
      "arrow_type": "Float32"
    },
    {
      "match": "exact",
      "native_type": "DOUBLE PRECISION",
      "arrow_type": "Float64"
    },
    {
      "match": "regex",
      "native_type": "DECIMAL(${p}, ${s})",
      "arrow_type": "^Decimal(?:128|256)\\((?<p>[1-9]|[12][0-9]|3[0-8]),\\s*(?<s>[0-9]|[12][0-9]|3[0-7])\\)$"
    },
    {
      "match": "exact",
      "native_type": "VARCHAR(65535)",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "VARCHAR(65535)",
      "arrow_type": "LargeUtf8"
    },
    {
      "match": "exact",
      "native_type": "SUPER",
      "arrow_type": "Json"
    },
    {
      "match": "exact",
      "native_type": "SUPER",
      "arrow_type": "Object"
    },
    {
      "match": "exact",
      "native_type": "SUPER",
      "arrow_type": "List"
    },
    {
      "match": "exact",
      "native_type": "VARBYTE(16777216)",
      "arrow_type": "Binary"
    },
    {
      "match": "exact",
      "native_type": "VARBYTE(16777216)",
      "arrow_type": "LargeBinary"
    },
    {
      "match": "regex",
      "native_type": "VARBYTE(16777216)",
      "arrow_type": "^FixedSizeBinary\\([0-9]+\\)$"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date32"
    },
    {
      "match": "exact",
      "native_type": "DATE",
      "arrow_type": "Date64"
    },
    {
      "match": "regex",
      "native_type": "TIME",
      "arrow_type": "^Time(?:32|64)\\([A-Z]+\\)$"
    },
    {
      "match": "regex",
      "native_type": "VARCHAR(65535)",
      "arrow_type": "^Duration\\([A-Z]+\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIMESTAMP",
      "arrow_type": "^Timestamp\\([A-Z]+,\\s*null\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIMESTAMPTZ",
      "arrow_type": "^Timestamp\\([A-Z]+,\\s*.+\\)$"
    },
    {
      "match": "regex",
      "native_type": "TIMESTAMP",
      "arrow_type": "^Timestamp\\([A-Z]+\\)$"
    }
  ]
}
